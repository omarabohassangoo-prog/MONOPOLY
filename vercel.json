{
  "version": 2,
  "framework": "vite",
  "installCommand": "bun install",
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/health/ready", "destination": "/api/health/ready" }
  ],
  "functions": {
    "api/[...path].ts": {
      "maxDuration": 60
    },
    "api/health/ready.ts": {
      "maxDuration": 30
    }
  }
}
